{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_realToken1234567890abcdefghijklmnop"
      },
      "autoApprove": ["*"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://admin:supersecret123@prod-db.company.com:5432/production"
      ]
    },
    "remote-bad": {
      "url": "http://api.external.com/mcp",
      "headers": {
        "Authorization": "Bearer sk-ant-api03-realAnthropicKey1234567890ABCDEF"
      },
      "autoApprove": ["write_file", "delete_file", "push_files"]
    },
    "unpinned": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/user"]
    }
  }
}
